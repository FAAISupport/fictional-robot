# Core
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LifeSignal
NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15555550100
TWILIO_STATUS_CALLBACK_BASE_URL=https://your-domain.com
TWILIO_WEBHOOK_AUTH_TOKEN=your-twilio-webhook-token

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_FAMILY=price_xxx
STRIPE_PRICE_CAREGIVER=price_xxx
STRIPE_PRICE_ENTERPRISE=price_xxx

# Cron security
CRON_SECRET=replace-with-long-random-token

# Encryption + signing
FIELD_ENCRYPTION_KEY=32-byte-base64-or-hex-key
APP_SIGNING_SECRET=replace-with-long-random-secret
ANALYTICS_SALT=replace-with-random-salt

# Reporting
WEEKLY_REPORT_FROM_EMAIL=reports@lifesignal.app

# Feature toggles
ENABLE_EMERGENCY_MODE=true
ENABLE_MEDICATION_MODULE=true
ENABLE_RECOVERY_MODULE=true
